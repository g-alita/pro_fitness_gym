MONGO_URI=your_mongodb_connection_string
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
# Optional legacy admin email allowlist; MongoDB profitnessgym.admin mail is also checked.
GOOGLE_ADMIN_EMAILS=admin@example.com
AUTH_SESSION_SECRET=generate_a_random_64_character_secret
# Used once per allowlisted phone to enroll an authenticator app.
ADMIN_TOTP_SETUP_TOKEN=generate_a_long_random_setup_token
APP_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Pro Fitness Gym <noreply@example.com>
# Optional contact form recipient; defaults to SMTP_USER, then SMTP_FROM.
CONTACT_EMAIL=contact@example.com
