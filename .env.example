PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
APP_BASE_URL=https://your-site.example
FRONTEND_ORIGIN=https://your-site.example
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
PHONE_OTP_SECRET=replace-with-a-different-long-random-secret

# Supabase Auth sends and verifies email sign-in codes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Enable Google Drive API and Google Sheets API, add your site origin to the web client's
# authorized JavaScript origins, and configure consent for Drive metadata and spreadsheet scopes.
# While the OAuth consent screen is in testing mode, add each admin Google account under Audience > Test users.
# Google may require app verification before sensitive Sheets scopes can be used outside testing.

# WhatsApp Cloud API sends phone sign-in codes using an approved authentication template.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v27.0
WHATSAPP_OTP_TEMPLATE_NAME=your_approved_authentication_template
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en

# Contact enquiries are emailed using Resend.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Pro Fitness Gym <verified-sender@your-domain.com>"
CONTACT_EMAIL=contact@your-domain.com

# SMTP is still used for password setup/reset emails, not email sign-in codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
